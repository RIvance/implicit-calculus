{
  "name": "implicit-synthesis-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "scripts": {
    "compiler:dev": "cd .. && sbt playground/fastLinkJS",
    "compiler:build": "cd .. && sbt playground/fullLinkJS",
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && npm run compiler:dev && vite --host 127.0.0.1",
    "build": "npm run assets && npm run compiler:build && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run compiler:dev && vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src \"bridge/*.ts\" e2e \"*.ts\" \"*.json\" index.html",
    "format:check": "prettier --check src \"bridge/*.ts\" e2e \"*.ts\" \"*.json\" index.html"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@monaco-editor/react": "4.7.0",
    "@xyflow/react": "12.12.0",
    "coi-serviceworker": "0.1.7",
    "comlink": "4.4.2",
    "lucide-react": "1.65.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.2",
    "z3-solver": "4.14.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
