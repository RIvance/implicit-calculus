// result: outer: Ada / inner: Ada

trait ToString[A] = { toString: A -> String }

implement ToString[String] = {
  toString = (text: String) => "outer: " ++ text
}

def captured(text: String): String = ToString[String]::toString(text)

implement ToString[String] = {
  toString = (text: String) => "inner: " ++ text
}

captured("Ada") ++ " / " ++ ToString[String]::toString("Ada")
