// result: {count = 21, value = Ada}

type Counted[A] = { value: A, count: Int }

instance text: String = "Ada"
instance count: Int = 21
instance counted[A](value: A, implicit count: Int): Counted[A] = {
  value = value
  count = count
}

// Synthesis infers A and supplies an ordinary argument followed by an implicit one.
summon[Counted[String]]
