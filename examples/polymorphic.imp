// result: Ada

type Printer[A] = { toString: A -> String }
type Conversion[A, B] = { repr: A -> B }
trait ToString[A] = Printer[A]
trait Repr[A, B] = Conversion[A, B]
type Person = { name: String }

instance string: Printer[String] = {
  toString = (text: String) => text
}

instance personName: Conversion[Person, String] = {
  repr = (person: Person) => person.name
}

instance via[A, B where Repr[A, B] and ToString[B]]: Printer[A] = {
  toString = (x: A) => ToString[B]::toString(Repr[A, B]::repr(x))
}

// The producer is a first-class value. Supply its type and implementation arguments explicitly.
instance person: Printer[Person] = via[Person, String](using personName, using string)

ToString[Person]::toString({ name = "Ada" })
