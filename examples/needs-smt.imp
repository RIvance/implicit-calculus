// result: Ada

trait ToString[A] = { toString: A -> String }
trait Repr[A, B] = { repr: A -> B }
type Person = { name: String }

implement ToString[String] = {
  toString = (text: String) => text
}

implement Repr[Person, String] = {
  repr = (person: Person) => person.name
}

implement[A, B where Repr[A, B] and ToString[B]] ToString[A] = {
  toString = (x: A) => ToString[B]::toString(Repr[A, B]::repr(x))
}

// Synthesis discovers B = String from the available implementations.
ToString[Person]::toString({ name = "Ada" })
