// result: value = Ada

type Printer[A] = { toString: A -> String }
trait ToString[A] = Printer[A]

def makePrinter(prefix: String): Printer[String] = {
  toString = (text: String) => prefix ++ text
}

def install(chosen: Printer[String]): String = {
  given active: Printer[String] = chosen
  ToString[String]::toString("Ada")
}

let printer = makePrinter("value = ")
install(printer)
