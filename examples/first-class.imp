// result: value = Ada

trait ToString[A] = { toString: A -> String }

def makePrinter(prefix: String): ToString[String] = {
  toString = (text: String) => prefix ++ text
}

let printer = makePrinter("value = ")

def install(chosen: ToString[String]): String = {
  impl active: ToString[String] = chosen
  ToString[String]::toString("Ada")
}

install(printer)
