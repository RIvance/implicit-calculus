// result: Student(Ada)

trait ToString[A] = {
  toString: A -> String
}

type Student = {
  name: String
  age: Int
}

implement ToString[String] = {
  toString = (text: String) => text
}

implement ToString[Student] = {
  toString = (s: Student) =>
    "Student(" ++ ToString[String]::toString(s.name) ++ ")"
}

def display[A where ToString[A]](x: A): String = x.toString

display[Student]({ name = "Ada", age = 21 })
