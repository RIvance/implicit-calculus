// result: {count = 21, value = Ada}

type Counted[A] = { value: A, count: Int }

instance count: Int = 21
instance counted[A](value: A, implicit count: Int): Counted[A] = {
  value = value
  count = count
}

// Synthesis specializes the function; the caller supplies its value arguments.
let countText = summon[String -> (Int ~> Counted[String])]
countText("Ada", using summon[Int])
