// result: 21

trait Default[A] = { value: A }

// The where constraint precedes the written ordinary and implicit parameters.
def choose[A where Default[A]](fallback: A, implicit preferred: A)(last: A): A = preferred

implement Default[Int] = { value = 11 }

// Applying 0 requests the where argument; using 21 supplies preferred directly.
choose[Int](0, using 21, 99)
